generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  ADMIN
}

enum VehicleStatus {
  AVAILABLE
  ON_TRIP
  MAINTENANCE
}

enum BookingStatus {
  PENDING
  ACCEPTED
  IN_TRANSIT
  DELIVERED
  CANCELLED
}

model User {
  id        String    @id @default(uuid())
  name      String
  email     String    @unique
  phone     String    @unique
  password  String
  role      Role      @default(CUSTOMER)
  createdAt DateTime  @default(now())
  bookings  Booking[]
}

model Driver {
  id            String    @id @default(uuid())
  name          String
  phone         String    @unique
  licenseNumber String    @unique
  vehicle       Vehicle?  @relation(fields: [vehicleId], references: [id])
  vehicleId     String?   @unique
  bookings      Booking[]
}

model Vehicle {
  id            String         @id @default(uuid())
  regNumber     String         @unique
  name          String         
  capacityTons  Float          
  status        VehicleStatus  @default(AVAILABLE)
  fuelPercent   Float          @default(100.0)
  lastLat       Float?
  lastLng       Float?
  lastSpeed     Float?
  lastUpdated   DateTime       @updatedAt
  driver        Driver?
  bookings      Booking[]
  gpsLogs       GpsLog[]
}

model Booking {
  id             String        @id @default(uuid())
  trackingCode   String        @unique
  customerId     String
  customer       User          @relation(fields: [customerId], references: [id])
  vehicleId      String?
  vehicle        Vehicle?      @relation(fields: [vehicleId], references: [id])
  driverId       String?
  driver         Driver?       @relation(fields: [driverId], references: [id])
  pickupAddress  String
  dropAddress    String
  cargoWeightTon Float
  goodsType      String
  status         BookingStatus @default(PENDING)
  totalFare      Float?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
}

model GpsLog {
  id          String   @id @default(uuid())
  vehicleId   String
  vehicle     Vehicle  @relation(fields: [vehicleId], references: [id])
  latitude    Float
  longitude   Float
  speed       Float
  fuelLevel   Float
  timestamp   DateTime @default(now())
}